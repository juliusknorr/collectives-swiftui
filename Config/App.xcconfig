PRODUCT_BUNDLE_IDENTIFIER = org.nextcloud.collectives.community
PRODUCT_NAME = Collectives
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SDKROOT = auto
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
TARGETED_DEVICE_FAMILY = 1,2
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_STYLE = Automatic
ENABLE_APP_SANDBOX = YES
CODE_SIGN_ENTITLEMENTS = Config/Collectives.entitlements
ENABLE_HARDENED_RUNTIME = YES
SWIFT_VERSION = 6.0

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Generate cached Text resources before the resource-copy phase.
ENABLE_USER_SCRIPT_SANDBOXING = NO
